# Justify backend — copy to .env and fill. Never commit .env.
PORT=8787

# Network: which contracts/deployments/<NETWORK>.json to load.
# arc-testnet (default) | base-sepolia | base-mainnet
NETWORK=base-sepolia

# RPC override (else the deployment file's rpc is used). RPC_URL preferred; ARC_RPC kept for back-compat.
# Base Sepolia: https://sepolia.base.org · Base mainnet: https://mainnet.base.org
RPC_URL=https://sepolia.base.org
ARC_RPC=https://rpc.testnet.arc.network

# Backend signer — acts as verifier (registerCreator), oracle (resolve) and faucet (gas dotation).
# Must equal the `backend` address in contracts/deployments/arc-testnet.json. KMS in prod.
BACKEND_PK=0x...

# On-chain Chainlink Data Feeds (settlement chain) for trustless price resolution.
# Set once verified at docs.chain.link for the active NETWORK. If unset, resolution
# falls back to the off-chain read. FEED_MAX_STALE_SEC bounds price freshness.
ONCHAIN_FEED_ETH=
ONCHAIN_FEED_BTC=
ONCHAIN_FEED_LINK=
FEED_MAX_STALE_SEC=3600

# OptimisticSettler (from DeployModules.s.sol). When set, subjective outcomes are PROPOSED
# (public challenge window; disputes escalate to UMA) instead of resolved directly.
SETTLER_ADDRESS=

# Gas dotation (BE11): native top-up so embedded wallets can pay gas. On Base native=ETH
# (tiny amounts); on Arc native=USDC. Defaults adapt to NETWORK; override here if needed.
GAS_DRIP_THRESHOLD=0.0002
GAS_DRIP_AMOUNT=0.0005

# AI (agent decisions = Haiku, resolution = Sonnet)
ANTHROPIC_API_KEY=

# World ID 4.0 (onboarding proof-of-human)
WORLD_APP_ID=app_...
WORLD_RP_ID=rp_...

# Blink deposit signer (ECDSA P-256). PEM file path + merchant id.
BLINK_MERCHANT_ID=
BLINK_PRIVATE_KEY_PEM=./blink-private.pem

# Agent / anti-sybil
APPROVAL_THRESHOLD_USDC=5
MAX_AGENTS_PER_HUMAN=3
FREE_TRIAL_BETS_PER_HUMAN=10

# BE12 — durable storage. If set, every store write is mirrored to Postgres (JSONB blob
# per table) and the cache is hydrated from it at boot. Unset = file-only (dev/demo).
DATABASE_URL=

# ── Product feature flags (call decisions 2026-06-14; defaults = product MVP) ──
# Agents & country-gate stay in the code but OFF; re-enable for the hackathon demo env.
FEATURE_AGENTS=off
FEATURE_COUNTRY_GATE=off
# Creator role granted ONLY via /api/admin/creator; World ID verify = just a checkmark.
CREATOR_VIA_ADMIN=true
# Shared secret for /api/admin/* (x-admin-secret header). Unset = admin API disabled.
ADMIN_SECRET=

# World ID RP signing (server-only) + dev bypass toggle
RP_SIGNING_KEY=
WORLD_ACTION=create-market
ALLOW_DEV_VERIFY=true

# ── 0G (Galileo testnet, chain 16602) ──────────────────────────────────────────
# Wallet the resolution agent uses for the 0G Compute ledger and Storage uploads.
# Fund it at https://faucet.0g.ai (the Compute ledger needs ~3 0G to open).
ZG_AGENT_PK=
ZG_RPC=https://evmrpc-testnet.0g.ai
ZG_CHAIN_ID=16602
ZG_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
# TeeML inference provider — see `broker.inference.listServiceWithDetail()` for live ones.
ZG_PROVIDER=0xa48f01287233509FD694a22Bf840225062E67836
ZG_LEDGER_TOPUP=3
# off | on — routes the resolution verdict through 0G Compute instead of the default model.
FEATURE_ZG=off
# JustifyAttestations deployment on 0G Galileo (anchors bundle roots on-chain).
ZG_ATTESTATIONS=

# ── The Graph ─────────────────────────────────────────────────────────────────
SUBGRAPH_URL=https://api.studio.thegraph.com/query/1756947/justify-markets/v0.2.0

# Demo curation: comma-separated market ids to show on the board (e.g. 10,13).
# Unset = show all. Hidden markets stay reachable by direct link and still resolve.
VISIBLE_MARKET_IDS=
